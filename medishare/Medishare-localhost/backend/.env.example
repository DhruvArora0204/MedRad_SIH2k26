# ==========================================
# MediShare Backend Environment Configuration
# ==========================================

# Server Port (Frontend expects MediShare at Port 5000)
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/medishare

# JWT Authentication Secret
JWT_SECRET=medishare_secret_jwt_key_2026

# Blockchain / Hardhat Local Node Configuration
API_URL=http://127.0.0.1:8545
# Default Hardhat Account #0 private key for local development
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Contract Address (Default local Hardhat deployment address)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Google Gemini AI API Key (Medical report parsing & diagnostic analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINERY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
