# ==============================================================================
# RADIS Backend & ML Pipeline .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/

# Python Build / Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage/
.nyc_output/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.local

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# ML Model Weights & Checkpoints (Heavy Binaries)
checkpoints/
*.pth
*.pt
*.onnx
*.h5

# Runtime Uploads & Generated Scans Data
data/uploads/
data/mock_dicom/
data/processed/
data/raw/
data/scans_metadata.json
*.tmp
*.temp

# Logs
logs/
*.log

# OS Files
.DS_Store
Thumbs.db
desktop.ini
